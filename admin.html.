<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Administration | Moonlight Digital</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f3f5f9;color:#202938}
header{background:#101827;color:white;padding:22px}
header h1{margin:0;font-size:23px}
header p{color:#cbd5e1}
main{max-width:1200px;margin:25px auto;padding:15px}
.panel{background:white;padding:20px;border-radius:12px;margin-bottom:20px}
input,button,select{padding:12px;border-radius:7px;border:1px solid #ddd}
button{background:#172b4d;color:white;border:0;cursor:pointer}
button:disabled{opacity:.6;cursor:not-allowed}
.release{border:1px solid #e5e7eb;border-radius:10px;padding:16px;margin:15px 0}
.cover{width:110px;height:110px;object-fit:cover;border-radius:8px}
audio{width:100%;margin:12px 0}
.status{font-weight:bold}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.actions select{flex:1;min-width:130px}
.hidden{display:none}
.error{color:#b91c1c}
.success{color:#15803d}
.tabs{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px}
.tabs button{background:#e5e7eb;color:#172b4d}
.tabs button.active{background:#172b4d;color:white}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin:20px 0}
.stat{border:1px solid #e5e7eb;border-radius:10px;padding:16px;background:#fff}
.stat p{font-size:13px;color:#667085;margin:0 0 10px}
.stat strong{font-size:23px;color:#1769ff}
.table-wrap{overflow-x:auto;margin-top:15px}
table{width:100%;border-collapse:collapse;min-width:750px}
th,td{padding:12px;border-bottom:1px solid #eee;text-align:left;font-size:13px}
th{background:#f8fafc}
.paid{color:#15803d;font-weight:bold}
.unpaid{color:#b45309;font-weight:bold}
.pay-button{background:#15803d;padding:8px 10px}
.section-title{margin-top:25px}
.message{margin:12px 0}
</style>
</head>
<body>
<header>
<h1>🌙 MOONLIGHT DIGITAL</h1>
<p>Espace administration</p>
</header>
<main>
<section id="loading" class="panel">
Vérification de votre accès...
</section>
<section id="dashboard" class="hidden">
<div class="panel">
<h2>Bienvenue dans votre espace administrateur</h2>
<div class="tabs">
<button class="active" id="musicTab">🎵 Gestion musicale</button>
<button id="marketTab">🛍️ Marketplace et commissions</button>
</div>
<button id="refresh">Actualiser</button>
<button id="logout">Déconnexion</button>
<p id="message"></p>
</div>
<div id="musicSection">
<div class="panel">
<h3>📁 Projets musicaux reçus</h3>
<div id="releases">Chargement...</div>
</div>
</div>
<div id="marketSection" class="hidden">
<div class="panel">
<h2>🛍️ Administration Marketplace</h2>
<p>Suivi des vendeurs, ventes déclarées et commissions Moonlight Digital.</p>
<p><strong>Commission de la plateforme : 10 %</strong></p>
<div class="stats">
<div class="stat">
<p>Vendeurs inscrits</p>
<strong id="sellerCount">0</strong>
</div>
<div class="stat">
<p>Ventes déclarées</p>
<strong id="salesCount">0</strong>
</div>
<div class="stat">
<p>Chiffre d'affaires déclaré</p>
<strong id="totalRevenue">0 $</strong>
</div>
<div class="stat">
<p>Commissions totales</p>
<strong id="totalCommission">0 $</strong>
</div>
<div class="stat">
<p>Commissions payées</p>
<strong id="paidCommission">0 $</strong>
</div>
<div class="stat">
<p>Commissions impayées</p>
<strong id="unpaidCommission">0 $</strong>
</div>
</div>
</div>
<div class="panel">
<h3>👥 Vendeurs inscrits</h3>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Boutique</th>
<th>WhatsApp</th>
<th>Adresse</th>
</tr>
</thead>
<tbody id="sellersTable">
<tr><td colspan="3">Chargement...</td></tr>
</tbody>
</table>
</div>
</div>
<div class="panel">
<h3>💰 Historique des ventes et commissions</h3>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Boutique</th>
<th>Produit</th>
<th>Quantité</th>
<th>Vente</th>
<th>Commission</th>
<th>Part vendeur</th>
<th>Date</th>
<th>Statut</th>
<th>Action</th>
</tr>
</thead>
<tbody id="salesTable">
<tr><td colspan="9">Chargement...</td></tr>
</tbody>
</table>
</div>
</div>
</div>
</section>
</main>
<script>
const SUPABASE_URL = "https://lmyefbevtukmtoijjlja.supabase.co";
const SUPABASE_KEY = "sb_publishable_6t-IlMpQAslqtctUJEmwKQ_0Wf5pBJ1";
const db = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
const loading = document.getElementById("loading");
const dashboard = document.getElementById("dashboard");
const message = document.getElementById("message");
let currentSection = "music";
function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g, char => ({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  })[char]);
}
function money(value) {
  return Number(value || 0).toLocaleString("fr-FR", {
    minimumFractionDigits:2,
    maximumFractionDigits:2
  }) + " $";
}
function showMessage(text, type = "success") {
  message.className = type;
  message.textContent = text;
}
async function initialize() {
  const {data:{session},error} = await db.auth.getSession();
  if(error || !session) {
    loading.textContent = "Connectez-vous d'abord à votre espace.";
    return;
  }
  const {data:isAdmin,error:adminError} = await db.rpc("is_admin");
  if(adminError || isAdmin !== true) {
    loading.innerHTML = '<p class="error">Accès refusé. Cette page est réservée aux administrateurs.</p>';
    return;
  }
  loading.classList.add("hidden");
  dashboard.classList.remove("hidden");
  await loadReleases();
}
function showSection(section) {
  currentSection = section;
  document.getElementById("musicSection").classList.toggle("hidden", section !== "music");
  document.getElementById("marketSection").classList.toggle("hidden", section !== "market");
  document.getElementById("musicTab").classList.toggle("active", section === "music");
  document.getElementById("marketTab").classList.toggle("active", section === "market");
  if(section === "market") loadMarketplace();
  if(section === "music") loadReleases();
}
document.getElementById("musicTab").addEventListener("click", () => showSection("music"));
document.getElementById("marketTab").addEventListener("click", () => showSection("market"));
document.getElementById("refresh").addEventListener("click", () => {
  if(currentSection === "music") loadReleases();
  else loadMarketplace();
});
document.getElementById("logout").addEventListener("click", async () => {
  await db.auth.signOut();
  window.location.href = "espace-artiste.html";
});
/* GESTION MUSICALE */
async function loadReleases() {
  const releasesDiv = document.getElementById("releases");
  releasesDiv.innerHTML = "Chargement des projets...";
  const {data:releases,error} = await db
    .from("releases")
    .select("*")
    .order("created_at",{ascending:false});
  if(error) {
    releasesDiv.innerHTML = '<p class="error">Erreur : '+escapeHTML(error.message)+'</p>';
    return;
  }
  if(!releases || releases.length === 0) {
    releasesDiv.innerHTML = "Aucun projet reçu pour le moment.";
    return;
  }
  const {data:profiles} = await db
    .from("profiles")
    .select("id,full_name,artist_name");
  const profileMap = {};
  (profiles || []).forEach(p => profileMap[p.id] = p);
  releasesDiv.innerHTML = "";
  for(const release of releases) {
    const profile = profileMap[release.user_id] || {};
    const artist = profile.artist_name || release.artist_name || profile.full_name || "Artiste";
    let audioHTML = "Audio non disponible";
    let coverHTML = "";
    if(release.audio_path) {
      const {data} = await db.storage
        .from("releases-audio")
        .createSignedUrl(release.audio_path,3600);
      if(data?.signedUrl) {
        audioHTML = '<audio controls src="'+escapeHTML(data.signedUrl)+'"></audio>';
      }
    }
    if(release.cover_path) {
      const {data} = await db.storage
        .from("releases-covers")
        .createSignedUrl(release.cover_path,3600);
      if(data?.signedUrl) {
        coverHTML = '<img class="cover" src="'+escapeHTML(data.signedUrl)+'" alt="Pochette">';
      }
    }
    const card = document.createElement("div");
    card.className = "release";
    card.innerHTML = `
      <h3>${escapeHTML(release.title)}</h3>
      <p><strong>Artiste :</strong> ${escapeHTML(artist)}</p>
      <p><strong>Type :</strong> ${escapeHTML(release.release_type)}</p>
      <p><strong>Date de sortie :</strong> ${escapeHTML(release.release_date || "Non précisée")}</p>
      <p><strong>Statut :</strong> <span class="status">${escapeHTML(release.status)}</span></p>
      ${coverHTML}
      ${audioHTML}
      <div class="actions">
        <select aria-label="Nouveau statut">
          <option value="pending">En attente</option>
          <option value="validated">Validé</option>
          <option value="rejected">Refusé</option>
          <option value="distributed">Distribué</option>
        </select>
        <button type="button">Enregistrer le statut</button>
      </div>
    `;
    const select = card.querySelector("select");
    const saveButton = card.querySelector("button");
    select.value = release.status || "pending";
    saveButton.addEventListener("click", async () => {
      saveButton.disabled = true;
      saveButton.textContent = "Enregistrement...";
      const {error:updateError} = await db
        .from("releases")
        .update({status:select.value})
        .eq("id",release.id);
      if(updateError) {
        showMessage("Erreur : " + updateError.message, "error");
      } else {
        showMessage("Statut du projet mis à jour !");
        card.querySelector(".status").textContent = select.value;
      }
      saveButton.disabled = false;
      saveButton.textContent = "Enregistrer le statut";
    });
    releasesDiv.appendChild(card);
  }
}
/* GESTION MARKETPLACE */
async function loadMarketplace() {
  showMessage("Chargement des données de la marketplace...");
  const [sellersResult, salesResult] = await Promise.all([
    db.from("public_seller_profiles")
      .select("id,shop_name,whatsapp,physical_address"),
    db.from("seller_sales")
      .select("*")
      .order("created_at",{ascending:false})
  ]);
  if(sellersResult.error) {
    showMessage("Erreur vendeurs : " + sellersResult.error.message, "error");
    return;
  }
  if(salesResult.error) {
    showMessage("Erreur ventes : " + salesResult.error.message, "error");
    return;
  }
  const sellers = sellersResult.data || [];
  const sales = salesResult.data || [];
  const sellerMap = {};
  sellers.forEach(s => sellerMap[s.id] = s);
  document.getElementById("sellerCount").textContent = sellers.length;
  document.getElementById("salesCount").textContent = sales.length;
  document.getElementById("sellersTable").innerHTML = sellers.length
    ? sellers.map(s => `
      <tr>
        <td>${escapeHTML(s.shop_name || "Sans nom")}</td>
        <td>${escapeHTML(s.whatsapp || "Non renseigné")}</td>
        <td>${escapeHTML(s.physical_address || "Non renseignée")}</td>
      </tr>
    `).join("")
    : '<tr><td colspan="3">Aucun vendeur inscrit.</td></tr>';
  const revenue = sales.reduce((sum,s) => sum + Number(s.sale_amount || 0),0);
  const commission = sales.reduce((sum,s) => sum + Number(s.commission || 0),0);
  const paid = sales
    .filter(s => s.payment_status === "paid")
    .reduce((sum,s) => sum + Number(s.commission || 0),0);
  const unpaid = sales
    .filter(s => s.payment_status === "unpaid")
    .reduce((sum,s) => sum + Number(s.commission || 0),0);
  document.getElementById("totalRevenue").textContent = money(revenue);
  document.getElementById("totalCommission").textContent = money(commission);
  document.getElementById("paidCommission").textContent = money(paid);
  document.getElementById("unpaidCommission").textContent = money(unpaid);
  document.getElementById("salesTable").innerHTML = sales.length
    ? sales.map(s => {
      const seller = sellerMap[s.seller_id] || {};
      const isPaid = s.payment_status === "paid";
      return `
        <tr>
          <td>${escapeHTML(seller.shop_name || "Vendeur")}</td>
          <td>${escapeHTML(s.product_name)}</td>
          <td>${Number(s.quantity || 0)}</td>
          <td>${money(s.sale_amount)}</td>
          <td>${money(s.commission)}</td>
          <td>${money(s.seller_amount)}</td>
          <td>${escapeHTML(s.sale_date)}</td>
          <td class="${isPaid ? "paid" : "unpaid"}">${isPaid ? "Payée" : "Impayée"}</td>
          <td>
            ${isPaid ? "—" : `<button class="pay-button" onclick="markAsPaid('${s.id}')">Marquer payée</button>`}
          </td>
        </tr>
      `;
    }).join("")
    : '<tr><td colspan="9">Aucune vente déclarée.</td></tr>';
  showMessage("Données de la marketplace actualisées.");
}
async function markAsPaid(saleId) {
  const confirmed = confirm(
    "Confirmer que Moonlight Digital a réellement reçu cette commission ?"
  );
  if(!confirmed) return;
  const {error} = await db
    .from("seller_sales")
    .update({payment_status:"paid"})
    .eq("id",saleId)
    .eq("payment_status","unpaid");
  if(error) {
    showMessage("Erreur : " + error.message, "error");
    return;
  }
  showMessage("Commission marquée comme payée.");
  await loadMarketplace();
}
initialize();
</script>
</body>
</html>
